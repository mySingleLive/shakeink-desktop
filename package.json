{
  "name": "shakeink",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "node --import tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:adapter": "node --import tsx --test tests/integration/pglite-adapter.test.ts",
    "typecheck": "tsc --noEmit",
    "generate": "prisma generate --schema prisma/schema.prisma",
    "generate:commands": "node scripts/generate-command-catalogs.mjs",
    "generate:test": "prisma generate --schema tests/fixtures/adapter.prisma",
    "build:ui": "next build",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build": "npm run generate && npm run build:ui && npm run build:desktop",
    "start": "electron .",
    "package": "node scripts/verify-macos-release.mjs --preflight && npm run build && node scripts/package-desktop.mjs",
    "package:dir": "npm run build && node scripts/package-desktop.mjs --dir",
    "package:check": "node scripts/inspect-packaged-app.mjs",
    "package:preflight": "node scripts/verify-macos-release.mjs --preflight",
    "package:verify:mac": "node scripts/verify-macos-release.mjs",
    "package:adhoc:mac": "node scripts/package-adhoc-macos.mjs --preflight && npm run build && node scripts/package-adhoc-macos.mjs",
    "test:package:adhoc": "node --import tsx --test tests/unit/macos-adhoc.test.ts",
    "test:package": "node --import tsx --test --test-concurrency=1 --test-timeout=100000 tests/unit/packaging-config.test.ts tests/unit/macos-release.test.ts tests/unit/macos-adhoc.test.ts tests/packaging/*.test.ts",
    "test:core:evidence": "node scripts/test-core.mjs",
    "typecheck:foundation": "tsc --project tsconfig.foundation.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.16",
    "@ai-sdk/deepseek": "^3.0.24",
    "@ai-sdk/openai": "^4.0.16",
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electric-sql/pglite": "0.5.8",
    "@hookform/resolvers": "^5.4.0",
    "@monaco-editor/react": "^4.7.0",
    "@napi-rs/canvas": "1.0.10",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "7.8.0",
    "@prisma/driver-adapter-utils": "7.8.0",
    "@tanstack/react-query": "^5.101.3",
    "ai": "^7.0.31",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "8.0.4",
    "docx": "^9.7.1",
    "entities": "^8.1.0",
    "highlight.js": "^11.11.1",
    "htmlparser2": "12.0.0",
    "jszip": "3.10.2",
    "lucide-react": "^1.25.0",
    "marked": "^18.0.7",
    "marked-highlight": "^2.2.4",
    "monaco-editor": "^0.56.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.3.289",
    "pglite-prisma-adapter": "0.7.2",
    "prisma": "7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.82.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.9.2",
    "sharp": "0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "undici": "7.30.0",
    "word-extractor": "1.0.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "shadcn": "^4.13.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "description": "玄印写作本地桌面创作应用",
  "license": "GPL-3.0-only",
  "main": "dist/main/index.cjs",
  "engines": {
    "node": ">=24 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mySingleLive/shakeink-desktop.git"
  }
}
